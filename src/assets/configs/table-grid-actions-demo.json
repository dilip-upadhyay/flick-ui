{
  "type": "layout",
  "components": [
    {
      "id": "header-1",
      "type": "header",
      "props": {
        "title": "Table Grid with Row Actions",
        "subtitle": "Demonstrating configurable row actions for table operations",
        "theme": "primary"
      }
    },
    {
      "id": "table-with-actions-1",
      "type": "table-grid",
      "props": {
        "collapsible": true,
        "collapsed": false,
        "showActionsColumn": true,
        "columns": [
          {
            "key": "id",
            "label": "ID",
            "type": "text",
            "sortable": true
          },
          {
            "key": "name",
            "label": "Name",
            "type": "text",
            "sortable": true
          },
          {
            "key": "email",
            "label": "Email",
            "type": "email",
            "sortable": true
          },
          {
            "key": "role",
            "label": "Role",
            "type": "select",
            "sortable": true,
            "options": [
              {
                "value": "admin",
                "label": "Admin"
              },
              {
                "value": "user",
                "label": "User"
              },
              {
                "value": "moderator",
                "label": "Moderator"
              }
            ]
          },
          {
            "key": "status",
            "label": "Status",
            "type": "text",
            "sortable": true
          }
        ],
        "rowActions": [
          {
            "id": "edit",
            "label": "Edit",
            "icon": "edit",
            "type": "update",
            "color": "primary",
            "tooltip": "Edit this user"
          },
          {
            "id": "delete",
            "label": "Delete",
            "icon": "delete",
            "type": "delete",
            "color": "warn",
            "tooltip": "Delete this user",
            "confirmMessage": "Are you sure you want to delete this user? This action cannot be undone."
          },
          {
            "id": "activate",
            "label": "Activate/Deactivate",
            "icon": "power_settings_new",
            "type": "custom",
            "color": "accent",
            "tooltip": "Toggle user activation status"
          },
          {
            "id": "view-details",
            "label": "View Details",
            "icon": "visibility",
            "type": "custom",
            "color": "primary",
            "tooltip": "View detailed information"
          }
        ],
        "data": [
          {
            "id": 1,
            "name": "Alice Johnson",
            "email": "alice.johnson@example.com",
            "role": "admin",
            "status": "active"
          },
          {
            "id": 2,
            "name": "Bob Smith",
            "email": "bob.smith@example.com",
            "role": "user",
            "status": "active"
          },
          {
            "id": 3,
            "name": "Charlie Brown",
            "email": "charlie.brown@example.com",
            "role": "user",
            "status": "inactive"
          },
          {
            "id": 4,
            "name": "Diana Prince",
            "email": "diana.prince@example.com",
            "role": "moderator",
            "status": "active"
          },
          {
            "id": 5,
            "name": "Ethan Hunt",
            "email": "ethan.hunt@example.com",
            "role": "user",
            "status": "pending"
          },
          {
            "id": 6,
            "name": "Fiona Glenanne",
            "email": "fiona.glenanne@example.com",
            "role": "user",
            "status": "active"
          },
          {
            "id": 7,
            "name": "George Miller",
            "email": "george.miller@example.com",
            "role": "admin",
            "status": "active"
          },
          {
            "id": 8,
            "name": "Hannah Lee",
            "email": "hannah.lee@example.com",
            "role": "user",
            "status": "inactive"
          }
        ],
        "pagination": true,
        "serverSide": false,
        "pageSize": 5,
        "pageSizeOptions": [5, 10, 25],
        "selectable": true,
        "theme": "default",
        "alternateRowColor": "#f5f5f5"
      },
      "gridPosition": {
        "row": 0,
        "col": 0,
        "width": 1,
        "height": 1
      }
    }
  ],
  "layout": {
    "type": "stack",
    "direction": "column"
  },
  "metadata": {
    "title": "Table Grid Row Actions Demo"
  }
}
